# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=foodstream

# Backend
BACKEND_PORT=8081
# Generate a secure secret and set it in your local `.env` or CI secrets
# Example (generate 32 bytes hex):
#   openssl rand -hex 32
JWT_SECRET=
STUN_SERVER_URL=stun:stun.l.google.com:19302

# WebRTC (set to your LAN IP for physical device testing, or 127.0.0.1 for local browser testing)
WEBRTC_IP=127.0.0.1
WEBRTC_PORT_MIN=50000
WEBRTC_PORT_MAX=50100

# Google OAuth Configuration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/google/callback

# Facebook OAuth Configuration (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8081/api/auth/facebook/callback
