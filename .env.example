# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=foodstream

# Backend
BACKEND_PORT=8081
# Generate a secure secret and set it in your local `.env` or CI secrets
# Example (generate 32 bytes hex):
#   openssl rand -hex 32
JWT_SECRET=
STUN_SERVER_URL=stun:stun.l.google.com:19302

# WebRTC (defaults to 50000-50100. On Windows, if Microsoft Teams or Hyper-V conflicts with 50000+, set to 40000 / 40050 in your local .env)
WEBRTC_IP=127.0.0.1
WEBRTC_PORT_MIN=50000
WEBRTC_PORT_MAX=50100

# Google OAuth Configuration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/google/callback

# Facebook OAuth Configuration (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8081/api/auth/facebook/callback

# Dev Mode (when true, prints OTP codes to server console and returns in API responses)
DEV_MODE=true

# Email Verification (SMTP - optional in dev, fallback to console simulation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@foodstream.io
# Frontend application URL for password reset links (e.g. http://localhost:3000 in dev, https://foodstream.tv on prod)
APP_URL=http://localhost:3000

