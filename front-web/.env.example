# Copy to .env.local for local development.

# Base URL the browser uses to reach the API. "/api" goes through the Next.js
# rewrite below, so no CORS and no hard-coded host.
NEXT_PUBLIC_API_BASE_URL=/api

# Where Next.js forwards /api/* and /replays-storage/* (the Go backend).
API_PROXY_TARGET=http://localhost:8081

# "true" shows the live player on /watch. Off by default: a running live is joined to cook with the
# chef, and watched as a replay once it ends.
NEXT_PUBLIC_LIVE_VIEWER=false
