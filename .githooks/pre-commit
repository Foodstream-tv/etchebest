#!/usr/bin/env bash
# Fast checks on the staged files only: gofmt for Go, ESLint for each JS/TS project.
# Installed by `make setup` (git config core.hooksPath .githooks). Skip once with: git commit --no-verify
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[[ ${#staged[@]} -eq 0 ]] && exit 0

status=0

# Go: every staged file must be gofmt-formatted.
go_files=()
for f in "${staged[@]}"; do [[ "$f" == backend/*.go ]] && go_files+=("$f"); done
if [[ ${#go_files[@]} -gt 0 ]]; then
  if command -v gofmt >/dev/null 2>&1; then
    unformatted="$(cd "$ROOT" && gofmt -l "${go_files[@]}")"
    if [[ -n "$unformatted" ]]; then
      printf 'pre-commit: fichiers Go non formatés (lancez gofmt -w) :\n%s\n' "$unformatted" >&2
      status=1
    fi
  else
    echo "pre-commit: gofmt introuvable, contrôle Go ignoré" >&2
  fi
fi

# JS/TS: ESLint on the staged files of each project (errors block, warnings do not).
lint_project() { # lint_project DIR
  local dir="$1" files=() f
  for f in "${staged[@]}"; do
    [[ "$f" == "$dir"/* && "$f" =~ \.(ts|tsx|js|jsx|mjs|cjs)$ ]] && files+=("${f#"$dir"/}")
  done
  [[ ${#files[@]} -eq 0 ]] && return 0
  if [[ ! -d "$ROOT/$dir/node_modules" ]]; then
    echo "pre-commit: $dir/node_modules absent (npm ci), lint ignoré" >&2
    return 0
  fi
  (cd "$ROOT/$dir" && npx --no-install eslint --no-warn-ignored "${files[@]}") || {
    echo "pre-commit: ESLint signale des erreurs dans $dir" >&2
    return 1
  }
}

for dir in front-web analytics mobile; do
  lint_project "$dir" || status=1
done

if [[ $status -ne 0 ]]; then
  echo "pre-commit: commit refusé. Corrigez, ou passez exceptionnellement avec git commit --no-verify." >&2
fi
exit $status
