# API Configuration
# In development leave this unset: the app builds the API url from Metro's address (so it follows your
# network, and the Android emulator reaches the host at 10.0.2.2). A local-network value here is also
# overridden by Metro's address. Set it for release builds (EAS profile): an https url, e.g.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api
EXPO_PUBLIC_API_TIMEOUT=10000

# Auth Storage Keys
EXPO_PUBLIC_TOKEN_KEY=auth_token
EXPO_PUBLIC_USER_KEY=auth_user

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional (Web only): must exactly match an authorized redirect URI in Google Cloud.
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=
